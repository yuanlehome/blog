---
import type { MarkdownHeading } from 'astro';
import type { ScalingBookEntry } from '../../lib/content/scalingBook';
import { normalizeBase } from '../../lib/slug';

interface Props {
  chapters: ScalingBookEntry[];
  currentSlug?: string;
  headings?: MarkdownHeading[];
}

const { chapters, currentSlug, headings = [] } = Astro.props;
const BASE = normalizeBase(import.meta.env.BASE_URL);
const bookBase = `${BASE}scaling-book/`;
const currentHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);

const chapterLabel = (chapter: ScalingBookEntry) =>
  chapter.data.chapter === 0 ? '导论' : `第 ${chapter.data.chapter} 章`;
---

<div class="min-w-0" data-book-sidebar>
  <details
    class="rounded-xl border border-zinc-200 bg-neutral-50/80 shadow-sm dark:border-zinc-800 dark:bg-zinc-900/60 lg:hidden"
  >
    <summary
      class="cursor-pointer select-none px-4 py-3 text-sm font-semibold text-zinc-900 dark:text-zinc-100"
    >
      全书目录
    </summary>
    <nav class="max-h-[60vh] overflow-y-auto border-t border-zinc-200 p-3 dark:border-zinc-800">
      <ol class="space-y-1" aria-label="Scaling Book 章节目录">
        {
          chapters.map((chapter) => (
            <li>
              <a
                href={`${bookBase}${chapter.slug}/`}
                aria-current={chapter.slug === currentSlug ? 'page' : undefined}
                class={`flex items-start gap-2 rounded-lg px-3 py-2 text-sm transition ${
                  chapter.slug === currentSlug
                    ? 'bg-sky-100 font-semibold text-sky-800 dark:bg-sky-950 dark:text-sky-300'
                    : 'text-zinc-700 hover:bg-zinc-100 hover:text-sky-700 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-sky-300'
                }`}
              >
                <span class="shrink-0 text-xs leading-5 text-zinc-500 dark:text-zinc-400">
                  {chapterLabel(chapter)}
                </span>
                <span>{chapter.data.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </details>

  <aside
    class="hidden lg:sticky lg:block lg:self-start"
    style="top: calc(var(--site-header-height) + var(--page-space-top)); max-height: calc(100dvh - var(--site-header-height) - var(--page-space-top) - 1rem);"
  >
    <div
      class="flex max-h-[inherit] flex-col overflow-hidden rounded-xl border border-zinc-200 bg-neutral-50/85 shadow-md backdrop-blur-sm dark:border-zinc-800 dark:bg-zinc-900/60"
    >
      <div class="border-b border-zinc-200 px-4 py-4 dark:border-zinc-800">
        <a
          href={bookBase}
          class="text-sm font-semibold text-zinc-900 transition hover:text-sky-600 dark:text-zinc-100 dark:hover:text-sky-400"
        >
          Scaling Book 中文版
        </a>
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">全书 13 章</p>
      </div>

      <nav class="min-h-0 flex-1 overflow-y-auto p-3" aria-label="Scaling Book 章节目录">
        <ol class="space-y-1">
          {
            chapters.map((chapter) => (
              <li>
                <a
                  href={`${bookBase}${chapter.slug}/`}
                  aria-current={chapter.slug === currentSlug ? 'page' : undefined}
                  class={`block rounded-lg px-3 py-2 text-sm leading-snug transition ${
                    chapter.slug === currentSlug
                      ? 'bg-sky-100 font-semibold text-sky-800 dark:bg-sky-950 dark:text-sky-300'
                      : 'text-zinc-700 hover:bg-zinc-100 hover:text-sky-700 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-sky-300'
                  }`}
                >
                  <span class="mb-0.5 block text-[0.68rem] uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
                    {chapterLabel(chapter)}
                  </span>
                  {chapter.data.title}
                </a>

                {chapter.slug === currentSlug && currentHeadings.length > 0 && (
                  <ol class="my-2 ml-3 space-y-1 border-l border-zinc-200 pl-3 dark:border-zinc-700">
                    {currentHeadings.map((heading) => (
                      <li>
                        <a
                          href={`#${heading.slug}`}
                          class={`block py-1 text-xs leading-snug text-zinc-500 transition hover:text-sky-600 dark:text-zinc-400 dark:hover:text-sky-400 ${
                            heading.depth === 3 ? 'pl-3' : ''
                          }`}
                        >
                          {heading.text}
                        </a>
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </aside>
</div>
